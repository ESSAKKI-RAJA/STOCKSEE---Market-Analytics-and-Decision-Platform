ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Finnhub API key for real news — get free key at https://finnhub.io
# Leave empty to use labeled demo/fallback news
FINNHUB_API_KEY=

# Supabase (optional — for auth and database persistence)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=sqlite:///./stocksee_dev.db

# Clerk Authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
